<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
  </startup>
  <connectionStrings>
    <!-- Sửa Server cho đúng máy của bạn (ví dụ .\SQLEXPRESS hoặc localhost) -->
    <add name="QuanLyNuocGiaiKhat"
         connectionString="Server=.\SQLEXPRESS;Database=QuanLyNuocGiaiKhat;Integrated Security=True;"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
</configuration>
